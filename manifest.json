{
  "manifest_version": 3,
  "name": "Music Bar",
  "version": "2.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "music-bar@Porfekto.dev",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "background": {
    "scripts": ["src/background.js"],
    "type": "module"
  },
  "content_scripts": [
  {
    "js": ["src/content.jsx"],
    "matches": ["<all_urls>"],
    "all_frames": false
  },
  {
      "js": ["src/youtube.js"],
      "matches": ["*://music.youtube.com/*"]
  },
  {
    "js": ["src/spotify.js"],
    "matches": ["*://*.spotify.com/*"]
  },
  {
    "js": ["src/apple-music.js"],
    "matches": ["*://music.apple.com/*"]
  }
],
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": ["<all_urls>"]
}
